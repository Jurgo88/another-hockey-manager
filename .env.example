# Optional. The scripts in scripts/github/ resolve credentials automatically:
#   token       <- `gh auth token`        (after `gh auth login`)
#   owner, repo <- `git remote get-url origin`
#
# So if the GitHub CLI is signed in, you do not need this file at all, and
# nothing sensitive ends up in the working tree.
#
# Set these only to override that - a dedicated scoped token, or a different
# target repository. Anything set here wins.

# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
