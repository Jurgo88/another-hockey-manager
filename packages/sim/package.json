{
  "name": "@ahm/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic hockey match and season simulation engine. Zero runtime dependencies.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:realism": "vitest run --project realism",
    "test:longrun": "vitest run --project longrun",
    "sim:season": "tsx src/cli/simulate-season.ts",
    "sim:roster": "tsx src/cli/export-roster.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.2"
  }
}
