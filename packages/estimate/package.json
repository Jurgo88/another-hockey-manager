{
  "name": "@ahm/estimate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real NHL Rosters estimated from public data, written as a roster file (ADR-021).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:realism": "vitest run --project realism",
    "test:longrun": "vitest run --project longrun",
    "sim:estimate": "tsx src/cli.ts",
    "sim:validate": "tsx src/cli-validate.ts",
    "sim:measure": "tsx src/cli-measure.ts"
  },
  "dependencies": {
    "@ahm/sim": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.2"
  }
}
